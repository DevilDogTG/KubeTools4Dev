<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:coreVm="using:KubeTools4Dev.Core.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             mc:Ignorable="d"
             x:Class="KubeTools4Dev.Views.ClusterTreeView"
             x:DataType="coreVm:ClusterTreeViewModel">

    <DockPanel>

        <!-- Add Cluster button at top -->
        <Button DockPanel.Dock="Top"
                Command="{Binding AddClusterCommand}"
                Classes="SidebarNavItem"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Margin="4,4,4,2"
                ToolTip.Tip="Add cluster from kubeconfig file">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                <TextBlock Text="Add Cluster" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- Section Header -->
        <TextBlock DockPanel.Dock="Top"
                   Text="KUBERNETES CLUSTERS"
                   Margin="8,8,8,4"
                   FontSize="10"
                   Opacity="0.6"/>

        <!-- Cluster Tree -->
        <TreeView x:Name="ClusterTree"
                  ItemsSource="{Binding Sources}"
                  SelectionMode="Single"
                  Background="Transparent">
            <TreeView.DataTemplates>

                <!-- Level 1: KubeConfigSourceNodeViewModel (Group header) -->
                <TreeDataTemplate DataType="coreVm:KubeConfigSourceNodeViewModel"
                                  ItemsSource="{Binding Clusters}">
                    <TextBlock Text="{Binding DisplayName}"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Margin="2,2,2,2"/>
                </TreeDataTemplate>

                <!-- Level 2: ClusterNodeViewModel -->
                <TreeDataTemplate DataType="coreVm:ClusterNodeViewModel"
                                  ItemsSource="{Binding Namespaces}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{Binding Status, Converter={StaticResource ClusterStatusToBrushConverter}}"/>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="10"
                                   Opacity="0.7"
                                   Foreground="{StaticResource SemiColorDanger}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </TreeDataTemplate>

                <!-- Level 3: NamespaceNodeViewModel -->
                <TreeDataTemplate DataType="coreVm:NamespaceNodeViewModel"
                                  ItemsSource="{Binding ResourceTypes}">
                    <TextBlock Text="{Binding Name}"
                               FontSize="11"
                               Opacity="0.8"
                               Margin="2,1,2,1"/>
                </TreeDataTemplate>

                <!-- Level 4 (leaf): ResourceTypeNodeViewModel -->
                <DataTemplate DataType="coreVm:ResourceTypeNodeViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <material:MaterialIcon Kind="{Binding Kind, Converter={StaticResource ResourceKindToIconConverter}}"
                                               Width="14" Height="14"
                                               VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>

            </TreeView.DataTemplates>
        </TreeView>

    </DockPanel>

</UserControl>
