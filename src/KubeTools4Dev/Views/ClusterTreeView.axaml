<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:coreVm="using:KubeTools4Dev.Core.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             mc:Ignorable="d"
             x:Class="KubeTools4Dev.Views.ClusterTreeView"
             x:DataType="coreVm:ClusterTreeViewModel">

    <DockPanel>

        <!-- Add Cluster button at top -->
        <Button DockPanel.Dock="Top"
                Command="{Binding AddClusterCommand}"
                Classes="SidebarNavItem"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Margin="4,4,4,2"
                ToolTip.Tip="Add cluster from kubeconfig file">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <material:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                <TextBlock Text="Add Cluster" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- Section Header -->
        <TextBlock DockPanel.Dock="Top"
                   Text="KUBERNETES CLUSTERS"
                   Margin="6,8,6,4"
                   FontSize="11"
                   Opacity="0.75"/>

        <!-- Custom tree: nested ItemsControl replaces TreeView for controlled indentation -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="2,0">

            <!-- Level 1: KubeConfig Sources -->
            <ItemsControl ItemsSource="{Binding Sources}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="coreVm:KubeConfigSourceNodeViewModel">
                        <StackPanel>

                            <!-- Source header row -->
                            <Button Classes="TreeNodeRow" Command="{Binding ToggleExpandedCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <material:MaterialIcon Kind="ChevronDown" Width="12" Height="12"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding IsExpanded}"/>
                                    <material:MaterialIcon Kind="ChevronRight" Width="12" Height="12"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !IsExpanded}"/>
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="SemiBold" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Level 2: Clusters -->
                            <ItemsControl ItemsSource="{Binding Clusters}"
                                          IsVisible="{Binding IsExpanded}"
                                          Margin="10,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="coreVm:ClusterNodeViewModel">
                                        <StackPanel>

                                            <!-- Cluster row: click to expand + auto-connect -->
                                            <Button Classes="TreeNodeRow" Command="{Binding ToggleAndConnectCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <material:MaterialIcon Kind="ChevronDown" Width="12" Height="12"
                                                                           VerticalAlignment="Center"
                                                                           IsVisible="{Binding IsExpanded}"/>
                                                    <material:MaterialIcon Kind="ChevronRight" Width="12" Height="12"
                                                                           VerticalAlignment="Center"
                                                                           IsVisible="{Binding !IsExpanded}"/>
                                                    <Ellipse Width="8" Height="8"
                                                             VerticalAlignment="Center"
                                                             Fill="{Binding Status, Converter={StaticResource ClusterStatusToBrushConverter}}"/>
                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ErrorMessage}"
                                                               FontSize="10" Opacity="0.7"
                                                               Foreground="{StaticResource SemiColorDanger}"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Level 3: Namespaces -->
                                            <ItemsControl ItemsSource="{Binding Namespaces}"
                                                          IsVisible="{Binding IsExpanded}"
                                                          Margin="10,0,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="coreVm:NamespaceNodeViewModel">
                                                        <StackPanel>

                                                            <!-- Namespace row -->
                                                            <Button Classes="TreeNodeRow" Command="{Binding ToggleExpandedCommand}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <material:MaterialIcon Kind="ChevronDown" Width="12" Height="12"
                                                                                           VerticalAlignment="Center"
                                                                                           IsVisible="{Binding IsExpanded}"/>
                                                                    <material:MaterialIcon Kind="ChevronRight" Width="12" Height="12"
                                                                                           VerticalAlignment="Center"
                                                                                           IsVisible="{Binding !IsExpanded}"/>
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="12"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>

                                                            <!-- Level 4: Resource Types (leaf nodes) -->
                                                            <ItemsControl ItemsSource="{Binding ResourceTypes}"
                                                                          IsVisible="{Binding IsExpanded}"
                                                                          Margin="10,0,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="coreVm:ResourceTypeNodeViewModel">
                                                                        <Button Classes="TreeNodeRow"
                                                                                Command="{Binding SelectCommand}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                <Border Width="5"/>
                                                                                <material:MaterialIcon
                                                                                    Kind="{Binding Kind, Converter={StaticResource ResourceKindToIconConverter}}"
                                                                                    Width="14" Height="14"
                                                                                    VerticalAlignment="Center"/>
                                                                                <TextBlock Text="{Binding DisplayName}"
                                                                                           FontSize="12"
                                                                                           VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </ScrollViewer>

    </DockPanel>

</UserControl>
