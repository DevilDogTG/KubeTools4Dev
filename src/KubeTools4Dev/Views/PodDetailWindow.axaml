<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:KubeTools4Dev.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
        x:Class="KubeTools4Dev.Views.PodDetailWindow"
        x:DataType="vm:PodDetailViewModel"
        Icon="avares://KubeTools4Dev/Assets/app-icon.png"
        Title="{Binding WindowTitle}"
        Width="900" Height="650"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Window.Styles>
        <Style Selector="TextBlock.eventWarning">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorWarning}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10,12,0" Spacing="6">
            <TextBlock Text="{Binding Pod.Name}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Pod.Namespace, StringFormat='[{0}]'}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding Containers}"
                      SelectedItem="{Binding SelectedContainer}"
                      IsVisible="{Binding ShowContainerPicker}"
                      FontSize="12" MinHeight="26" Padding="8,2"
                      VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="10,4,10,10" SelectedIndex="{Binding SelectedViewIndex}">

            <!-- Logs tab -->
            <TabItem Header="Logs">
                <Grid Margin="0,6,0,0" RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding LogFilter}"
                                 PlaceholderText="Filter logs..."
                                 FontSize="12" MinHeight="26" Padding="8,2"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LogFilterStatus}"
                                   IsVisible="{Binding HasLogFilter}"
                                   FontSize="11" Opacity="0.6"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" Margin="0,6,0,0"
                                  x:Name="LogsScrollViewer"
                                  ScrollChanged="LogsScrollViewer_ScrollChanged">
                        <SelectableTextBlock Text="{Binding PodLogsText}"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Describe tab -->
            <TabItem Header="Describe">
                <Grid Margin="0,6,0,0" RowDefinitions="Auto,*">
                    <ProgressBar Grid.Row="0" IsIndeterminate="True" IsVisible="{Binding IsDescribeLoading}" Height="4" Margin="0,0,0,4"/>
                    <ScrollViewer Grid.Row="1">
                        <TextBox Text="{Binding PodDescribeText}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Background="Transparent"
                                 BorderThickness="0"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Events tab -->
            <TabItem Header="Events">
                <Grid Margin="0,6,0,0" RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <ProgressBar Grid.Column="0" IsIndeterminate="True" IsVisible="{Binding IsEventsLoading}"
                                     Height="4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Refresh"
                                Command="{Binding RefreshEventsCommand}"
                                FontSize="12" Height="24" Padding="8,0"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding EventsError}"
                               IsVisible="{Binding HasEventsError}"
                               Foreground="{DynamicResource SemiColorDanger}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="1" Text="No events for this pod."
                               IsVisible="{Binding ShowNoEvents}"
                               FontSize="12" Opacity="0.6" Margin="0,6,0,0"/>

                    <ScrollViewer Grid.Row="2" Margin="0,6,0,0">
                        <ItemsControl ItemsSource="{Binding PodEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PodEventRow">
                                    <Border BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Type}"
                                                       Classes.eventWarning="{Binding IsWarning}"
                                                       FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Reason}"
                                                       FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding AgeDisplay}"
                                                       FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding Message}"
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
