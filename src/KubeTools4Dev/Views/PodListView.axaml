<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KubeTools4Dev.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="KubeTools4Dev.Views.PodListView"
             x:DataType="vm:PodListViewModel">
    
    <UserControl.Styles>
        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Height" Value="20"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10">
            <TextBox Text="{Binding FilterText}" Watermark="Filter pods..." Width="300"/>
            <TextBlock Text="{Binding Pods.Count, StringFormat='Total: {0}'}" VerticalAlignment="Center"/>
            <TextBlock Text="Refresh (s):" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Border CornerRadius="4" BorderThickness="1" BorderBrush="#444444" Padding="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Content="-" Command="{Binding DecrementRefreshIntervalCommand}" Padding="8,0" Height="24" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RefreshIntervalSeconds, StringFormat='{}{0}s'}" VerticalAlignment="Center" Width="30" TextAlignment="Center"/>
                    <Button Content="+" Command="{Binding IncrementRefreshIntervalCommand}" Padding="8,0" Height="24" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding LastRefreshTime, StringFormat='Last Updated: {0}'}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Pods}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserResizeColumns="True" CanUserSortColumns="True" Margin="0,10,0,0"
                  RowHeight="20" FontSize="12" GridLinesVisibility="Horizontal"
                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                  ScrollViewer.IsScrollChainingEnabled="False"
                  ScrollViewer.AllowAutoHide="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Namespace" Binding="{Binding Namespace}" Width="Auto"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                
                <DataGridTemplateColumn Header="Status" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" VerticalAlignment="Center" Margin="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Restarts" Binding="{Binding Restarts}" Width="60"/>
                <DataGridTextColumn Header="Last Restart" Binding="{Binding LastRestart}" Width="80"/>
                <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
