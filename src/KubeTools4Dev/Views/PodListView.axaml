<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:KubeTools4Dev.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="KubeTools4Dev.Views.PodListView"
			 x:DataType="vm:PodListViewModel">

	<UserControl.Styles>
        <Style Selector="DataGridColumnHeadersPresenter">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
		<Style Selector="DataGridRow">
            <Setter Property="Height" Value="22"/>
			<Setter Property="Margin" Value="3,2,3,0"/>
			<Setter Property="MinHeight" Value="22"/>
		</Style>
		<Style Selector="DataGridCell">
			<Setter Property="Height" Value="22"/>
			<Setter Property="MinHeight" Value="22"/>
			<Setter Property="Padding" Value="3,0"/>
		</Style>
	</UserControl.Styles>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="{Binding PanelWidth, Mode=TwoWay}" />
		</Grid.ColumnDefinitions>

		<Grid Grid.Column="0" RowDefinitions="Auto, *">
			<StackPanel Orientation="Horizontal"
						Spacing="10"
						Margin="10">
				<TextBox Text="{Binding FilterText}"
						 PlaceholderText="Filter pods..."
						 Width="200" Height="20"/>
				<TextBlock Text="{Binding Pods.Count, StringFormat='Total: {0}'}"
						   VerticalAlignment="Center"/>
				<TextBlock Text="Refresh (s):"
						   VerticalAlignment="Center"
						   Margin="10,0,0,0"/>
				<Border CornerRadius="4"
						BorderThickness="1"
						BorderBrush="#444444"
						Padding="0"
						VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal">
						<Button Content="-"
								Command="{Binding DecrementRefreshIntervalCommand}"
								Padding="8,0"
								Height="24"
								VerticalAlignment="Center"/>
						<TextBlock Text="{Binding RefreshIntervalSeconds, StringFormat='{}{0}s'}"
								   VerticalAlignment="Center"
								   Width="30" 
								   TextAlignment="Center"/>
						<Button Content="+"
								Command="{Binding IncrementRefreshIntervalCommand}"
								Padding="8,0"
								Height="24"
								VerticalAlignment="Center"/>
					</StackPanel>
				</Border>
				<TextBlock Text="{Binding LastRefreshTime, StringFormat='Last Updated: {0}'}"
						   VerticalAlignment="Center"
						   Margin="10,0,0,0"/>
				<ProgressBar IsIndeterminate="True"
							 IsVisible="{Binding IsLoading}" />
			</StackPanel>

			<DataGrid Grid.Row="1"
					  AutoGenerateColumns="False"
					  CanUserResizeColumns="True"
					  CanUserSortColumns="True"
					  FontSize="12"
					  GridLinesVisibility="Horizontal"
					  IsReadOnly="True"
					  ItemsSource="{Binding Pods}"
					  Margin="0,10,0,0"
					  RowHeight="20"
					  VerticalScrollBarVisibility="Visible">
				<DataGrid.Columns>
					<DataGridTextColumn Binding="{Binding Namespace}"
										Header="Namespace"
										Width="Auto"/>
					<DataGridTextColumn Binding="{Binding Name}"
										Header="Name"
										Width="*"/>

					<DataGridTemplateColumn Header="Status"
											Width="130">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Status}"
										   Foreground="{Binding StatusColor}"
										   Height="20"
										   Margin="0"
										   VerticalAlignment="Center"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<DataGridTextColumn Binding="{Binding CpuUsage}"
										Header="CPU"
										Width="80"/>
					<DataGridTextColumn Binding="{Binding RamUsage}"
										Header="RAM"
										Width="80"/>
					<DataGridTextColumn Binding="{Binding Restarts}"
										Header="Restarts"
										Width="60"/>
					<DataGridTextColumn Binding="{Binding LastRestart}"
										Header="Last Restart"
										Width="80"/>
					<DataGridTextColumn Binding="{Binding Age}"
										Header="Age"
										Width="60"/>
					
					<DataGridTemplateColumn Header="Actions" Width="140">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal" Spacing="5" Margin="5,0" VerticalAlignment="Center">
									<Button Content="Logs"
											Command="{Binding $parent[UserControl].((vm:PodListViewModel)DataContext).ShowLogsCommand}"
											CommandParameter="{Binding}"
											Padding="5,0"
											Height="20"/>
									<Button Content="Describe"
											Command="{Binding $parent[UserControl].((vm:PodListViewModel)DataContext).ShowDescribeCommand}"
											CommandParameter="{Binding}"
											Padding="5,0"
											Height="20"/>
								</StackPanel>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</Grid>

		<!-- Splitter -->
		<GridSplitter Grid.Column="1" 
					  Width="4" 
					  Background="#444444" 
					  IsVisible="{Binding IsPanelOpen}" 
					  HorizontalAlignment="Center"
					  VerticalAlignment="Stretch"/>

		<!-- Side Panel -->
		<Grid Grid.Column="2" RowDefinitions="Auto,*" Background="#252526" IsVisible="{Binding IsPanelOpen}">
			<StackPanel Orientation="Horizontal" Margin="10,10,10,0">
				<TextBlock Text="{Binding SelectedPodDetail.Name, StringFormat='Pod: {0}'}"
						   FontWeight="Bold"
						   FontSize="14"
						   VerticalAlignment="Center"/>
				<Button Content="Close"
						Command="{Binding ClosePanelCommand}"
						Margin="10,0,0,0"/>
			</StackPanel>

			<TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="10">
				<TabItem Header="Logs">
					<ScrollViewer x:Name="LogsScrollViewer" ScrollChanged="LogsScrollViewer_ScrollChanged">
						<ItemsControl ItemsSource="{Binding PodLogsList}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</TabItem>
				<TabItem Header="Describe">
					<ScrollViewer>
						<TextBox Text="{Binding PodDescribeText}"
								 IsReadOnly="True"
								 FontFamily="Consolas"
								 FontSize="12"
								 TextWrapping="Wrap"
								 AcceptsReturn="True"
								 Background="Transparent"
								 BorderThickness="0"/>
					</ScrollViewer>
				</TabItem>
			</TabControl>
		</Grid>
	</Grid>
</UserControl>
