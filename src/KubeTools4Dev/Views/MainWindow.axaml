<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KubeTools4Dev.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:KubeTools4Dev.Views"
        xmlns:material="using:Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="700"
        x:Class="KubeTools4Dev.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://KubeTools4Dev/Assets/app-icon.png"
        Title="Kubernetes Tools (for Developer)">

    <Grid RowDefinitions="Auto, *">
        <!-- Header / Status Bar -->
        <Border Grid.Row="0" Margin="5" Padding="3" Background="{DynamicResource SemiColorBackground0}" CornerRadius="4">
             <Grid ColumnDefinitions="Auto, *, Auto">
                 <StackPanel Orientation="Horizontal" Spacing="10" Grid.Column="0">
                     <TextBlock Text="Status:" VerticalAlignment="Center" FontWeight="Bold"/>
                     <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center"/>
                     <Button Content="Reconnect" Command="{Binding ConnectCommand}" IsVisible="{Binding !IsConnected}" Classes="Warning Small"/>
                 </StackPanel>

                 <TextBlock Grid.Column="2" 
                            Text="{Binding ClusterName, StringFormat='Cluster: {0}'}" 
                            VerticalAlignment="Center" 
                            FontWeight="SemiBold"
                            Margin="10,0"
                            IsVisible="{Binding IsConnected}"/>
             </Grid>
        </Border>

        <!-- Body: Sidebar + Content -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto, *" Margin="5">

            <!-- LEFT SIDEBAR NAVIGATION -->
            <Border Grid.Column="0" Classes="SidebarNav" CornerRadius="4" Margin="0,0,5,0"
                    Width="{Binding SidebarWidth}">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Width" Duration="0:0:0.2"/>
                    </Transitions>
                </Border.Transitions>
                <DockPanel>

                    <!-- Collapse / expand toggle -->
                    <Button DockPanel.Dock="Top"
                            Command="{Binding ToggleSidebarCommand}"
                            Classes="SidebarToggle"
                            HorizontalAlignment="Right"
                            Margin="4,4,4,2">
                        <Panel>
                            <material:MaterialIcon Kind="ChevronLeft" Width="18" Height="18"
                                                   IsVisible="{Binding IsSidebarExpanded}"/>
                            <material:MaterialIcon Kind="ChevronRight" Width="18" Height="18"
                                                   IsVisible="{Binding !IsSidebarExpanded}"/>
                        </Panel>
                    </Button>

                    <ListBox SelectedIndex="{Binding SelectedNavIndex, Mode=TwoWay}"
                             Classes="SidebarNavList">
                        <ListBoxItem Classes="SidebarNavItem" ToolTip.Tip="Pods">
                            <Grid ColumnDefinitions="20,*">
                                <material:MaterialIcon Kind="LayersTriple" Width="20" Height="20"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Pods" Margin="8,0,0,0" VerticalAlignment="Center"
                                           IsVisible="{Binding IsSidebarExpanded}"/>
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem Classes="SidebarNavItem" ToolTip.Tip="Services">
                            <Grid ColumnDefinitions="20,*">
                                <material:MaterialIcon Kind="ShareVariant" Width="20" Height="20"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Services" Margin="8,0,0,0" VerticalAlignment="Center"
                                           IsVisible="{Binding IsSidebarExpanded}"/>
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem Classes="SidebarNavItem" ToolTip.Tip="Settings">
                            <Grid ColumnDefinitions="20,*">
                                <material:MaterialIcon Kind="Cog" Width="20" Height="20"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Settings" Margin="8,0,0,0" VerticalAlignment="Center"
                                           IsVisible="{Binding IsSidebarExpanded}"/>
                            </Grid>
                        </ListBoxItem>
                    </ListBox>

                </DockPanel>
            </Border>

            <!-- MAIN CONTENT AREA -->
            <Border Grid.Column="1" Background="{DynamicResource SemiColorBackground0}" CornerRadius="4">
                <Panel>
                    <Panel IsVisible="{Binding IsPodsVisible}">
                        <views:PodListView DataContext="{Binding PodList}"/>
                    </Panel>
                    <Panel IsVisible="{Binding IsServicesVisible}">
                        <views:ServiceListView DataContext="{Binding ServiceList}"/>
                    </Panel>
                    <Panel IsVisible="{Binding IsSettingsVisible}">
                        <views:SettingsView DataContext="{Binding Settings}"/>
                    </Panel>
                </Panel>
            </Border>

        </Grid>
    </Grid>
</Window>
