<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KubeTools4Dev.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:KubeTools4Dev.Views"
        xmlns:coreVm="using:KubeTools4Dev.Core.ViewModels"
        xmlns:material="using:Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="KubeTools4Dev.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://KubeTools4Dev/Assets/app-icon.png"
        Title="Kubernetes Tools (for Developer)">

    <Grid>

        <!-- Body: Sidebar + Splitter + Content -->
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="160" MaxWidth="520"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Classes="SidebarNav" CornerRadius="4">
                <DockPanel>

                    <!-- Settings button at bottom -->
                    <Button DockPanel.Dock="Bottom"
                            Command="{Binding ShowSettingsCommand}"
                            Classes="SidebarNavItem"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="4,2,4,4"
                            ToolTip.Tip="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon Kind="Cog" Width="18" Height="18"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Cluster Tree -->
                    <views:ClusterTreeView DataContext="{Binding ClusterTree}"/>

                </DockPanel>
            </Border>

            <!-- RESIZABLE SPLITTER -->
            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Background="Transparent"
                          Cursor="SizeWestEast"
                          Width="5"/>

            <!-- MAIN CONTENT AREA -->
            <Border Grid.Column="2" Background="{DynamicResource SemiColorBackground0}" CornerRadius="4">
                <Panel>

                    <!-- Welcome / empty state -->
                    <Panel IsVisible="{Binding IsWelcomePanelVisible}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <material:MaterialIcon Kind="Kubernetes" Width="64" Height="64" Opacity="0.3"
                                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="Select a resource from the cluster tree"
                                       HorizontalAlignment="Center"
                                       Opacity="0.5"
                                       FontSize="14"/>
                            <TextBlock Text="Double-click a cluster to connect"
                                       HorizontalAlignment="Center"
                                       Opacity="0.4"
                                       FontSize="12"/>
                        </StackPanel>
                    </Panel>

                    <!-- Pods -->
                    <Panel IsVisible="{Binding IsPodsPanelVisible}">
                        <views:PodListView DataContext="{Binding PodList}"/>
                    </Panel>

                    <!-- Services -->
                    <Panel IsVisible="{Binding IsServicesPanelVisible}">
                        <views:ServiceListView DataContext="{Binding ServiceList}"/>
                    </Panel>

                    <!-- Deployments -->
                    <Panel IsVisible="{Binding IsDeploymentsPanelVisible}">
                        <views:DeploymentListView DataContext="{Binding DeploymentList}"/>
                    </Panel>

                    <!-- Settings -->
                    <Panel IsVisible="{Binding IsSettingsPanelVisible}">
                        <views:SettingsView DataContext="{Binding Settings}"/>
                    </Panel>

                </Panel>
            </Border>

        </Grid>
    </Grid>
</Window>
