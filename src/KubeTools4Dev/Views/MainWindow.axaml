<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KubeTools4Dev.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:KubeTools4Dev.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="KubeTools4Dev.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://KubeTools4Dev/Assets/app-icon.png"
        Title="Kubernetes Tools (for Developer)">

    <Grid RowDefinitions="Auto, *">
        <!-- Header / Status Bar -->
        <Border Grid.Row="0" Margin="5" Padding="3" Background="{DynamicResource SemiColorBackground0}" CornerRadius="4">
             <Grid ColumnDefinitions="Auto, *, Auto">
                 <StackPanel Orientation="Horizontal" Spacing="10" Grid.Column="0">
                     <TextBlock Text="Status:" VerticalAlignment="Center" FontWeight="Bold"/>
                     <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center"/>
                     <Button Content="Reconnect" Command="{Binding ConnectCommand}" IsVisible="{Binding !IsConnected}" Classes="Warning Small"/>
                 </StackPanel>

                 <TextBlock Grid.Column="2" 
                            Text="{Binding ClusterName, StringFormat='Cluster: {0}'}" 
                            VerticalAlignment="Center" 
                            FontWeight="SemiBold"
                            Margin="10,0"
                            IsVisible="{Binding IsConnected}"/>
             </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="3">
            <TabItem Header="Pods">
                <views:PodListView DataContext="{Binding PodList}"/>
            </TabItem>
            <TabItem Header="Services">
                <views:ServiceListView DataContext="{Binding ServiceList}"/>
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView DataContext="{Binding Settings}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
