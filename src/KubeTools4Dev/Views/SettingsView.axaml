<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KubeTools4Dev.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="KubeTools4Dev.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:Name="Root">

    <UserControl.Styles>
        <Style Selector="DataGridColumnHeadersPresenter">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Height" Value="22"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Margin" Value="3,2,3,0"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*, Auto" Margin="10">

        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="10">
                <!-- General Section -->
                <Border Classes="Card"
                        Theme="{StaticResource CardBorder}"
                        Padding="10">
                     <StackPanel Spacing="5">
                        <TextBlock Text="General"
                                   Classes="H4"
                                   FontWeight="Bold" />
                        <TextBlock Text="Logging Configuration"
                                   FontWeight="SemiBold" />
                        
                        <Grid ColumnDefinitions="Auto, *"
                              RowDefinitions="Auto, Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Log Level:"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding LogLevels}"
                                      SelectedItem="{Binding LogLevel}"
                                      Height="28"
                                      FontSize="12"
                                      HorizontalAlignment="Stretch"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Log Path:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" Spacing="2">
                                <TextBox Text="{Binding LogPath}"
                                         Height="28"
                                         FontSize="12"
                                         PlaceholderText="Default Path"/>
                                <SelectableTextBlock Text="{Binding CurrentLogPath, StringFormat='Active: {0}'}"
                                                     FontSize="11"
                                                     Foreground="Gray"
                                                     TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                     </StackPanel>
                </Border>

                <!-- Pods Section -->
                <Border Classes="Card"
                        Theme="{StaticResource CardBorder}"
                        Padding="10">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Pods"
                                   Classes="H4"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Refresh Settings"
                                   FontWeight="SemiBold" />
                        
                        <Grid ColumnDefinitions="Auto, *"
                              RowDefinitions="Auto, Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Refresh Interval (Seconds):"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <Border Grid.Row="0" Grid.Column="1"
                                    CornerRadius="4"
                                    BorderThickness="1"
                                    BorderBrush="#444444"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="-"
                                            Command="{Binding DecrementRefreshIntervalSecondsCommand}"
                                            Padding="6,0"
                                            Height="20"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RefreshIntervalSeconds, StringFormat='{}{0}s'}"
                                               VerticalAlignment="Center"
                                               Width="36"
                                               FontSize="12"
                                               TextAlignment="Center"/>
                                    <Button Content="+"
                                            Command="{Binding IncrementRefreshIntervalSecondsCommand}"
                                            Padding="6,0"
                                            Height="20"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Watch Retry Delay (ms):"
                                       VerticalAlignment="Center"
                                       Margin="0,5,10,0"/>
                            <Border Grid.Row="1" Grid.Column="1"
                                    CornerRadius="4"
                                    BorderThickness="1"
                                    BorderBrush="#444444"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="0,5,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="-"
                                            Command="{Binding DecrementWatchRetryDelayCommand}"
                                            Padding="6,0"
                                            Height="20"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding WatchRetryDelayMilliseconds, StringFormat='{}{0}ms'}"
                                               VerticalAlignment="Center"
                                               Width="52"
                                               FontSize="12"
                                               TextAlignment="Center"/>
                                    <Button Content="+"
                                            Command="{Binding IncrementWatchRetryDelayCommand}"
                                            Padding="6,0"
                                            Height="20"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Services Section -->
                <Border Classes="Card" Theme="{StaticResource CardBorder}" Padding="10">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Services"
                                   Classes="H4"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Filtering &amp; Exclusion Rules (Comma/Newline Separated)"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="Hidden Service Names:" />
                        <TextBox Text="{Binding HiddenServiceNamesText}"
                                 AcceptsReturn="True"
                                 Height="50"
                                 FontSize="12"
                                 PlaceholderText="e.g. kubernetes, kube-dns"/>

                        <TextBlock Text="Hidden Service Types:" />
                        <TextBox Text="{Binding HiddenServiceTypesText}"
                                 AcceptsReturn="True"
                                 Height="50"
                                 FontSize="12"
                                 PlaceholderText="e.g. ExternalName, ClusterIP"/>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,10,0,0">
            <Button Content="About"
                    Height="28"
                    Padding="8,0"
                    Command="{Binding OpenAboutCommand}"/>
            <Button Content="Save"
                    Height="28"
                    Padding="8,0"
                    Command="{Binding SaveCommand}" Classes="Primary"/>
        </StackPanel>
    </Grid>
</UserControl>
