<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KubeTools4Dev.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="KubeTools4Dev.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid RowDefinitions="*, Auto" Margin="10">

        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="20">
                <!-- General Section -->
                <Border Classes="Card" Theme="{StaticResource CardBorder}" Padding="15">
                     <StackPanel Spacing="10">
                        <TextBlock Text="General" Classes="H4" FontWeight="Bold"/>
                        <TextBlock Text="Logging Configuration" FontWeight="SemiBold" />
                        
                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Log Level:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" HorizontalAlignment="Stretch"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Log Path:" VerticalAlignment="Center" Margin="0,10,10,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LogPath}" Watermark="Default Path" Margin="0,10,0,0"/>
                        </Grid>
                     </StackPanel>
                </Border>

                <!-- Pods Section -->
                <Border Classes="Card" Theme="{StaticResource CardBorder}" Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Pods" Classes="H4" FontWeight="Bold"/>
                        <TextBlock Text="Refresh Settings" FontWeight="SemiBold" />
                        
                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Refresh Interval (Seconds):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding RefreshIntervalSeconds}" Minimum="1" Maximum="3600" />
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Watch Retry Delay (ms):" VerticalAlignment="Center" Margin="0,10,10,0"/>
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding WatchRetryDelayMilliseconds}" Minimum="100" Maximum="60000" Margin="0,10,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Services Section -->
                <Border Classes="Card" Theme="{StaticResource CardBorder}" Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Services" Classes="H4" FontWeight="Bold"/>
                        <TextBlock Text="Filtering &amp; Exclusion Rules (Comma/Newline Separated)" FontWeight="SemiBold" />

                        <TextBlock Text="Hidden Service Names:" />
                        <TextBox Text="{Binding HiddenServiceNamesText}" AcceptsReturn="True" Height="60" Watermark="e.g. kubernetes, kube-dns"/>

                        <TextBlock Text="Hidden Service Types:" />
                        <TextBox Text="{Binding HiddenServiceTypesText}" AcceptsReturn="True" Height="60" Watermark="e.g. ExternalName, ClusterIP"/>

                        <TextBlock Text="Excluded Services (Auto-Port-Forward):" />
                        <TextBox Text="{Binding ExcludedServicesText}" AcceptsReturn="True" Height="60" Watermark="Services excluded from auto-forwarding"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="About" Command="{Binding OpenAboutCommand}"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Classes="Primary"/>
        </StackPanel>
    </Grid>
</UserControl>
