<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KubeTools4Dev.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="KubeTools4Dev.Views.ServiceListView"
             x:DataType="vm:ServiceListViewModel">

    <UserControl.Styles>
        <Style Selector="DataGridColumnHeadersPresenter">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Height" Value="22"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="MinHeight" Value="22"/>
			<Setter Property="Margin" Value="3,2,3,0"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="MinHeight" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        <StackPanel Orientation="Horizontal"
                    MinHeight="20"
                    Spacing="10"
                    Margin="10">
            
            <TextBox Watermark="Filter services..."
                     Text="{Binding FilterText}"
                     Width="200" 
                     Height="20"
                     Margin="0,0,5,0"/>
            <Button Content="Forward All"
                    Command="{Binding ForwardAllCommand}"
                    Padding="5"
                    FontSize="10"
                    Classes="Primary"/>
            <Button Content="Stop All"
                    Command="{Binding StopAllCommand}"
                    Padding="5"
                    FontSize="10"
                    Classes="Danger"/>

            <ProgressBar IsIndeterminate="True"
                         IsVisible="{Binding IsLoading}" />
        </StackPanel>

        <DataGrid Grid.Row="1"
                  AutoGenerateColumns="False" 
                  CanUserResizeColumns="True"
				  CanUserSortColumns="True"
                  ItemsSource="{Binding Services}"
                  FontSize="12"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="False"
                  Margin="0,10,0,0"
                  RowHeight="20"
				  VerticalScrollBarVisibility="Visible">
            <DataGrid.Columns>
               <DataGridTemplateColumn Header="Exclude"
                                       Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsExcluded}"
                                      Margin="4,0,0,0"
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Active"
                                        Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ToggleSwitch IsChecked="{Binding IsForwarding}"
                                          OnContent="On"
                                          OffContent="Off"
                                          Margin="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTextColumn Header="Namespace"
                                    Binding="{Binding Namespace}"
                                    IsReadOnly="True"
                                    Width="Auto"/>
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    IsReadOnly="True"
                                    Width="*"/>
                <DataGridTextColumn Header="Target Port"
                                    Binding="{Binding TargetPortDisplay}"
                                    IsReadOnly="True"
                                    Width="80"/>
                
                <DataGridTemplateColumn Header="Local Port"
                                        Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                             <TextBlock Text="{Binding LocalPort}"
                                        VerticalAlignment="Center"
                                        Margin="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding LocalPort}"
                                     Margin="0"
                                     Padding="2"
                                     MinHeight="18"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    IsReadOnly="True"
                                    Width="100"/>
                <DataGridTextColumn Header="Duration"
                                    Binding="{Binding DurationText}"
                                    IsReadOnly="True"
                                    Width="100"/>

                <DataGridTemplateColumn Width="70" Header="Open">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🌐"
                                    AutomationProperties.Name="Open in Browser"
                                    Command="{Binding OpenBrowserCommand}"
                                    IsEnabled="{Binding IsForwarding}"
                                    HorizontalAlignment="Center"
                                    Margin="2"
                                    Padding="5,2"
                                    ToolTip.Tip="Open in Browser"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
