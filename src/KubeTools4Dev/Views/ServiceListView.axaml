<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KubeTools4Dev.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="KubeTools4Dev.Views.ServiceListView"
             x:DataType="vm:ServiceListViewModel">

    <UserControl.Styles>
        <Style Selector="DataGridColumnHeadersPresenter">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Height" Value="22"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="MinHeight" Value="22"/>
			<Setter Property="Margin" Value="3,2,3,0"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="MinHeight" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
        </Style>
        <Style Selector="Button.Success">
            <Setter Property="Background" Value="#2e7d32"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.Success:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#388e3c"/>
        </Style>
        <Style Selector="Button.Success:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1b5e20"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Row 0: Filter + profile selector bar -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    MinHeight="20"
                    Spacing="6"
                    Margin="10,10,10,4">

            <TextBox PlaceholderText="Filter services..."
                     Text="{Binding FilterText}"
                     Width="160"
                     Height="20"
                     Margin="0"/>

            <!-- Profile selector -->
            <ComboBox ItemsSource="{Binding Profiles}"
                      SelectedItem="{Binding SelectedProfile}"
                      PlaceholderText="— no profile —"
                      DisplayMemberBinding="{Binding Name}"
                      Width="160"
                      Height="20"
                      FontSize="10"
                      Padding="4,0"
                      ToolTip.Tip="Select a port-forward profile"/>

            <!-- Start / Stop profile -->
            <Button Content="▶ Start"
                    Command="{Binding StartProfileCommand}"
                    Height="20"
                    Padding="5,0"
                    FontSize="10"
                    Classes="Primary"
                    ToolTip.Tip="Start all forwards in the selected profile"/>
            <Button Content="■ Stop"
                    Command="{Binding StopProfileCommand}"
                    Height="20"
                    Padding="5,0"
                    FontSize="10"
                    Classes="Danger"
                    ToolTip.Tip="Stop all forwards started by the selected profile"/>

            <!-- Profile management -->
            <Button Content="+"
                    Command="{Binding ShowCreateProfileInputCommand}"
                    Height="20"
                    Width="22"
                    Padding="2,0"
                    FontSize="12"
                    ToolTip.Tip="Create a new profile"/>
            <Button Content="🗑"
                    Command="{Binding DeleteProfileCommand}"
                    Height="20"
                    Width="22"
                    Padding="2,0"
                    FontSize="10"
                    Classes="Danger"
                    ToolTip.Tip="Delete the selected profile"/>

            <ProgressBar IsIndeterminate="True"
                         IsVisible="{Binding IsLoading}"
                         Width="60"/>
        </StackPanel>

        <!-- Row 1: New profile name input (collapsed until + is clicked) -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="10,0,10,4"
                    IsVisible="{Binding IsProfileNameInputVisible}">
            <TextBox PlaceholderText="Profile name…"
                     Text="{Binding NewProfileName}"
                     Width="200"
                     Height="20"
                     FontSize="10"/>
            <Button Content="✓ Create"
                    Command="{Binding CreateProfileCommand}"
                    Height="20"
                    Padding="5,0"
                    FontSize="10"
                    Classes="Primary"/>
            <Button Content="✕"
                    Command="{Binding CancelCreateProfileCommand}"
                    Height="20"
                    Width="22"
                    Padding="2,0"
                    FontSize="10"/>
        </StackPanel>

        <!-- Row 2: Service data grid -->
        <DataGrid Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
				      CanUserSortColumns="True"
                  ItemsSource="{Binding Services}"
                  FontSize="12"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="False"
                  Margin="0,4,0,0"
                  RowHeight="20"
				      VerticalScrollBarVisibility="Visible">
            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Active"
                                        Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ToggleSwitch IsChecked="{Binding IsForwarding}"
                                          OnContent="On"
                                          OffContent="Off"
                                          Margin="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Profile membership column -->
                <DataGridTemplateColumn Header="Profile"
                                        Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ServiceViewModel">
                            <Panel HorizontalAlignment="Center">
                                <!-- Add button shown when not in profile -->
                                <Button Content="＋"
                                        Command="{Binding AddToProfileCommand}"
                                        IsVisible="{Binding !IsInSelectedProfile}"
                                        Height="16"
                                        Width="18"
                                        Padding="0"
                                        FontSize="10"
                                        HorizontalAlignment="Center"
                                        ToolTip.Tip="Add to selected profile"/>
                                <!-- Remove button shown when in profile -->
                                <Button Content="✓"
                                        Command="{Binding RemoveFromProfileCommand}"
                                        IsVisible="{Binding IsInSelectedProfile}"
                                        Height="16"
                                        Width="18"
                                        Padding="0"
                                        FontSize="10"
                                        Classes="Success"
                                        HorizontalAlignment="Center"
                                        ToolTip.Tip="Remove from selected profile"/>
                            </Panel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Namespace"
                                    Binding="{Binding Namespace}"
                                    IsReadOnly="True"
                                    Width="Auto"/>
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    IsReadOnly="True"
                                    Width="*"/>
                <DataGridTextColumn Header="Target Port"
                                    Binding="{Binding TargetPortDisplay}"
                                    IsReadOnly="True"
                                    Width="80"/>

                <DataGridTemplateColumn Header="Local Port"
                                        Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                             <TextBlock Text="{Binding LocalPort}"
                                        VerticalAlignment="Center"
                                        Margin="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding LocalPort}"
                                     Margin="0"
                                     Padding="2"
                                     MinHeight="18"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    IsReadOnly="True"
                                    Width="100"/>
                <DataGridTextColumn Header="Duration"
                                    Binding="{Binding DurationText}"
                                    IsReadOnly="True"
                                    Width="100"/>

                <DataGridTemplateColumn Width="70" Header="Open">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🌐"
                                    AutomationProperties.Name="Open in Browser"
                                    Command="{Binding OpenBrowserCommand}"
                                    IsEnabled="{Binding IsForwarding}"
                                    HorizontalAlignment="Center"
                                    Margin="2"
                                    Padding="5,2"
                                    ToolTip.Tip="Open in Browser"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
