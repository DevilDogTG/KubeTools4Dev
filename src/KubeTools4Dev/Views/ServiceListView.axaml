<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:KubeTools4Dev.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="KubeTools4Dev.Views.ServiceListView"
             x:DataType="vm:ServiceListViewModel">

    <UserControl.Styles>
        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Height" Value="20"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="MinHeight" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10">
            <Button Content="Forward All" Command="{Binding ForwardAllCommand}" Classes="Primary"/>
            <Button Content="Stop All" Command="{Binding StopAllCommand}" Classes="Danger"/>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Services}" AutoGenerateColumns="False" 
                  IsReadOnly="False" CanUserResizeColumns="True" Margin="0,10,0,0"
                  RowHeight="20" FontSize="12" GridLinesVisibility="Horizontal"
                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                  ScrollViewer.IsScrollChainingEnabled="False"
                  ScrollViewer.AllowAutoHide="False">
            <DataGrid.Columns>
               <DataGridTemplateColumn Header="Exclude" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsExcluded}" Margin="4,0,0,0" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Active" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ToggleSwitch IsChecked="{Binding IsForwarding}" OnContent="On" OffContent="Off" Margin="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTextColumn Header="Namespace" Binding="{Binding Namespace}" IsReadOnly="True" Width="Auto"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Target Port" Binding="{Binding TargetPortDisplay}" IsReadOnly="True" Width="80"/>
                
                <DataGridTemplateColumn Header="Local Port" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                             <TextBlock Text="{Binding LocalPort}" VerticalAlignment="Center" Margin="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding LocalPort}" Margin="0" Padding="2" MinHeight="18"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" IsReadOnly="True" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
